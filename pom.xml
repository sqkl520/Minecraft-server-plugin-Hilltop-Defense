<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hilltopvillage</groupId>
    <artifactId>HilltopVillage</artifactId>
    <version>1.1.1</version>
    <packaging>jar</packaging>

    <name>HilltopVillage</name>
    <description>Hilltop Village - Cooperative PvE Tower Defense</description>

    <properties>
        <!-- 编译目标版本。刻意不叫 java.version：
             ${java.version} 是 JVM 系统属性（运行 Maven 的实际 JDK 版本），
             enforcer 的错误提示需要用它来报告「当前检测到」的真实版本。 -->
        <java.target.version>21</java.target.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Test-only stack. MockBukkit 4.45.0 is the newest release in ~/.m2 that both
             pins paper-api 1.21.4-R0.1-SNAPSHOT (the project's own API level) and asks
             for JUnit 5.x (5.12.1). 4.116.3 requires JUnit 6.0.3, which would force a
             junit-platform 6 upgrade, so it is deliberately NOT used. -->
        <junit.version>5.12.1</junit.version>
        <mockbukkit.version>4.45.0</mockbukkit.version>
        <mockito.version>5.8.0</mockito.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <!-- PlaceholderAPI 的发布仓库（不在 Maven Central）。 -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/releases/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- PlaceholderAPI：provided，不进 JAR。运行时由服务器上的 PAPI 提供；
             缺席时 PlaceholderResolver 安静降级（见该类 javadoc）。 -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- STORY-0.3 Spike: JUnit5 仅 test-scope（示例测试用），不打进插件 JAR -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- MockBukkit：测试内假服务端。test-scope，不进插件 JAR。
             它自带 paper-api(compile)，但本项目已用 provided 声明同版本，Maven 就近取胜，
             不会把 paper-api 打进产物。 -->
        <dependency>
            <groupId>org.mockbukkit.mockbukkit</groupId>
            <artifactId>mockbukkit-v1.21</artifactId>
            <version>${mockbukkit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Mockito：spy/mock 生产类与 Bukkit 接口，绕开 MockBukkit 未实现的成员。
             byte-buddy-agent 必须显式声明（MockBukkit 只带 byte-buddy），
             否则 JDK 21 上 inline mock maker 初始化失败。 -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- 注意：不需要显式声明 byte-buddy-agent —— mockito-core 5.8.0 已把它作为
             compile-scope 依赖带进来（会随 test scope 生效）。已实测确认：
             去掉显式声明后 MockitoAvailabilityProbeTest 仍全绿。 -->
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <!-- R-6: 在 validate 阶段最早检查运行 Maven 的 JDK。
                 ${java.version} 在这里是 JVM 系统属性（运行 Maven 的实际 JDK 版本），
                 maven-compiler-plugin 的编译目标改用 ${java.target.version}，
                 避免 pom 属性遮蔽 JVM 属性、把「目标 21」误报成「当前 JDK 21」。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-jdk-21</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message><![CDATA[
【JDK 版本不匹配】需要 JDK 21，当前检测到 ${java.version}（pom.xml 编译目标为 ${java.target.version}）。
JVM 实际版本：${java.specification.version}（${java.runtime.version}）。
当前 JAVA_HOME=${java.home}，也就是运行 Maven 的 JDK 不是 21。
解决办法（任选其一）：
  1) 运行 ./tools/build.sh clean package（本机/CI 自动探测并切换 JDK 21）；
  2) 手动执行：export JAVA_HOME="/path/to/jdk-21" 后再运行 mvn；
     若本机 JDK 21 在别处，可用 HV_JDK21_HOME 覆盖：export HV_JDK21_HOME="/path/to/jdk21"。
注意：不要用 JDK 17 直接跑 mvn，否则只会得到晦涩的「无效的目标发行版: 21」。
]]></message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${java.target.version}</source>
                    <target>${java.target.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>